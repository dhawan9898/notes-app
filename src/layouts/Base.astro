---
import '../styles/global.css';
import '../styles/glass.css';
import Search from 'astro-pagefind/components/Search';
import { url } from '../lib/tracks';
import { getCollection } from 'astro:content';
const totalNotes = (await getCollection('notes')).length;

const { title, description = 'Senior-level, source-backed notes on C, DSA, Linux, and L2/L3 Networking.' } = Astro.props;
const siteUrl = Astro.site ? Astro.site.toString() : 'https://dhawan9898.github.io/notes-app/';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="dn-base" content={url('/')} />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="DeepNotes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📚</text></svg>" />

    <script is:inline>
      const t = localStorage.getItem('theme');
      if (t) document.documentElement.dataset.theme = t;
    </script>
  </head>
  <body data-total={totalNotes}>
    <div class="backdrop" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="readbar" aria-hidden="true"><i id="readbar"></i></div>
    <header class="top">
      <div class="in">
        <a class="brand" href={url('/')}>
          <span class="brand-icon">📚</span>
          <span class="brand-text">Deep<span>Notes</span></span>
        </a>
        <nav class="header-nav" aria-label="Main navigation">
          <a href={url('/c/')} class="nav-link">C</a>
          <a href={url('/linux/')} class="nav-link">Linux</a>
          <a href={url('/networking/')} class="nav-link">Networking</a>
          <a href={url('/dsa/')} class="nav-link">DSA</a>
          <a href={url('/roadmap/')} class="nav-link nav-roadmap">Roadmap</a>
          <a href={url('/playground/')} class="nav-link">Playground</a>
          <a href={url('/glossary/')} class="nav-link">Glossary</a>
        </nav>
        <div class="spacer"></div>
        <a class="progress-pill glass-hover" href={url('/roadmap/')} data-overall title="Your overall progress">
          <svg viewBox="0 0 36 36" width="26" height="26" aria-hidden="true"><circle class="ring-bg" cx="18" cy="18" r="15" /><circle class="ring-fg" data-ring-fg cx="18" cy="18" r="15" transform="rotate(-90 18 18)" /></svg>
          <span class="pp-text"><b data-stat="percent">0</b>%</span>
        </a>
        <div class="search-wrapper">
          <Search />
          <span class="search-hint" aria-hidden="true" title="Press Ctrl+K or / to search"><kbd>Ctrl</kbd><kbd>K</kbd></span>
        </div>
        <button class="icon theme-toggle" id="theme" aria-label="Toggle theme" title="Toggle dark/light theme">
          <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-in">
        <div class="footer-meta">
          <strong>DeepNotes</strong> — Senior-level notes on C, DSA, Linux, and Networking.
        </div>
        <div class="footer-links">
          <a href="https://github.com/dhawan9898/notes-app" target="_blank" rel="noopener">GitHub</a>
          <a href={url('/')}>All Tracks</a>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/app';
      import '../scripts/runner';
    </script>
    <script is:inline>
      // Offline support: cache pages the reader has visited (see public/sw.js)
      if ('serviceWorker' in navigator && location.protocol !== 'file:' && !window.Capacitor) {
        addEventListener('load', () => navigator.serviceWorker.register(document.querySelector('link[rel=manifest]').getAttribute('href').replace('manifest.webmanifest', 'sw.js')).catch(() => {}));
      }
    </script>
    <script>
      // Theme toggle
      const themeBtn = document.getElementById('theme');
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          const el = document.documentElement;
          const dark = el.dataset.theme ? el.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          el.dataset.theme = dark ? 'light' : 'dark';
          localStorage.setItem('theme', el.dataset.theme);
        });
      }

      // Search shortcut (Ctrl+K, Cmd+K, /)
      window.addEventListener('keydown', (e) => {
        const isSearchKey = (e.key === 'k' && (e.metaKey || e.ctrlKey)) || 
          (e.key === '/' && !['INPUT', 'TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName));
        if (isSearchKey) {
          const input = document.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
          if (input) {
            e.preventDefault();
            input.focus();
            input.select();
          }
        }
      });

      // Mermaid diagrams rendering
      const blocks = document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]');
      if (blocks.length) {
        import('mermaid').then(({ default: mermaid }) => {
          const dark = document.documentElement.dataset.theme === 'dark' ||
            (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
          mermaid.initialize({ startOnLoad: false, theme: dark ? 'dark' : 'default' });
          blocks.forEach(async (b, i) => {
            try {
              const { svg } = await mermaid.render('m' + i, b.textContent || '');
              const d = document.createElement('div');
              d.className = 'mermaid-wrap';
              d.innerHTML = svg;
              b.replaceWith(d);
            } catch (err) {
              console.error('Mermaid render error:', err);
            }
          });
        });
      }

      // Code blocks copy buttons
      document.querySelectorAll<HTMLElement>('article pre').forEach((pre) => {
        if (pre.getAttribute('data-language') === 'mermaid') return;
        const btn = document.createElement('button');
        btn.className = 'copy-code-btn';
        btn.setAttribute('aria-label', 'Copy code snippet');
        btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
        
        btn.addEventListener('click', async () => {
          const code = pre.querySelector('code')?.innerText || pre.innerText;
          try {
            await navigator.clipboard.writeText(code);
            btn.classList.add('copied');
            btn.setAttribute('title', 'Copied!');
            setTimeout(() => {
              btn.classList.remove('copied');
              btn.removeAttribute('title');
            }, 2000);
          } catch (e) {
            console.error('Copy failed', e);
          }
        });
        pre.style.position = 'relative';
        pre.appendChild(btn);
      });

      // Heading permalinks
      document.querySelectorAll<HTMLHeadingElement>('article h2[id], article h3[id]').forEach((h) => {
        const anchor = document.createElement('a');
        anchor.className = 'heading-anchor';
        anchor.href = `#${h.id}`;
        anchor.setAttribute('aria-label', `Permalink to ${h.innerText}`);
        anchor.innerText = '#';
        h.appendChild(anchor);
      });
    </script>
  </body>
</html>
