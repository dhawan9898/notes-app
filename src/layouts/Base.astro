---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';
import Icon from '../components/Icon.astro';
import { url } from '../lib/content';

export interface Props { title: string; description?: string; nav?: 'home' | 'learn' | 'practice' | 'you' | 'search' | ''; }
const { title, description = 'Source-backed notes, practice and labs for C, data structures and algorithms, Linux and networking.', nav = '' } = Astro.props;
const site = Astro.site ? Astro.site.toString() : 'https://dhawan9898.github.io/notes-app/';
const canonical = new URL(Astro.url.pathname, site).toString();
const TABS = [
  { id: 'home', label: 'Home', href: '/', icon: 'home' },
  { id: 'learn', label: 'Learn', href: '/learn/', icon: 'learn' },
  { id: 'practice', label: 'Practice', href: '/practice/', icon: 'practice' },
  { id: 'search', label: 'Search', href: '/search/', icon: 'search' },
  { id: 'you', label: 'You', href: '/you/', icon: 'you' },
] as const;
---
<!doctype html>
<html lang="en" data-theme="light" data-text="m" data-motion="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="icon" href={url('/icon.svg')} type="image/svg+xml" />
    <meta name="dn-base" content={url('/')} />
    <meta name="theme-color" content="#f4f6fb" />
    <meta property="og:site_name" content="DeepNotes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Apply the saved preferences before the first paint (theme, text size, reduced motion). Mirrors src/scripts/lib/settings.ts.
      (function () {
        var e = document.documentElement, d = {};
        try { var s = JSON.parse(localStorage.getItem('dn:settings') || 'null'); d = (s && s.data) || {}; if (!d.theme) { var o = localStorage.getItem('theme'); if (o === 'dark' || o === 'light') d.theme = o; } } catch (x) {}
        var dark = d.theme === 'dark' || (d.theme !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        e.dataset.theme = dark ? 'dark' : 'light'; e.dataset.text = d.text || 'm'; e.dataset.motion = d.motion || 'system';
      })();
    </script>
  </head>
  <body>
    <div class="bg" aria-hidden="true"><i></i><i></i><i></i></div>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="topbar-in">
        <a class="brand" href={url('/')} aria-label="DeepNotes home"><span class="brand-mark"><Icon name="book" size={18} /></span><span>Deep<b>Notes</b></span></a>
        <nav class="topnav" aria-label="Primary">
          {TABS.filter((t) => t.id !== 'search').map((t) => <a href={url(t.href)} aria-current={nav === t.id ? 'page' : undefined}>{t.label}</a>)}
        </nav>
        <span class="grow"></span>
        <a class="icon-btn" href={url('/search/')} aria-label="Search (press /)" title="Search  ( / )"><Icon name="search" /></a>
        <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch between light and dark theme" title="Theme"><Icon name="sun" class="i-sun" /><Icon name="moon" class="i-moon" /></button>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="footer">
      <div class="footer-in">
        <span><b>DeepNotes</b>: source-backed notes on C, DSA, Linux and networking.</span>
        <span class="footer-links"><a href={url('/paths/')}>Paths</a><a href={url('/glossary/')}>Glossary</a><a href={url('/about/')}>About</a><a href="https://github.com/dhawan9898/notes-app" rel="noopener">GitHub</a></span>
      </div>
    </footer>

    <nav class="tabbar" aria-label="Primary">
      {TABS.map((t) => <a href={url(t.href)} aria-current={nav === t.id ? 'page' : undefined}><Icon name={t.icon} size={22} /><span>{t.label}</span></a>)}
    </nav>

    <script>import '../scripts/shell';</script>
    <script is:inline>
      if ('serviceWorker' in navigator && location.protocol !== 'file:' && !window.Capacitor) {
        addEventListener('load', function () { navigator.serviceWorker.register(document.querySelector('link[rel=manifest]').getAttribute('href').replace('manifest.webmanifest', 'sw.js')).catch(function () {}); });
      }
    </script>
  </body>
</html>
