---
import Base from '../layouts/Base.astro';
import NotesData from '../components/NotesData.astro';
import { TRACKS, learningPath, noteHref, readingMinutes, url, type TrackId } from '../lib/tracks';

const steps = await learningPath();
const stages: { name: string; steps: typeof steps }[] = [];
for (const s of steps) {
  const last = stages[stages.length - 1];
  if (last && last.name === s.stage) last.steps.push(s); else stages.push({ name: s.stage, steps: [s] });
}
const totalMinutes = steps.reduce((a, s) => a + readingMinutes(s.note), 0);
---
<Base title="Learning roadmap · DeepNotes" description="One ordered curriculum through all four tracks, with progress tracking.">
  <NotesData steps={steps} />
  <main class="wrap roadmap">
    <section class="rm-hero glass" data-reveal>
      <div class="rm-hero-main">
        <p class="eyebrow">Learning roadmap</p>
        <h1>Your path through {steps.length} notes</h1>
        <p class="lead">One recommended order: the four <em>Start here</em> modules, then the beginner <em>Essentials</em> of every track, then the core notes with the four tracks taken in turn. Every note comes after the notes it builds on, so you can follow the list top to bottom. About {Math.round(totalMinutes / 60)} hours of reading in total.</p>
        <a class="cta-card glass-hover" data-continue="all" hidden>
          <span class="cta-label" data-continue-label>Start learning</span>
          <strong class="cta-title" data-continue-title></strong>
          <span class="cta-arrow">→</span>
        </a>
      </div>
      <div class="rm-hero-stats" data-overall>
        <div class="big-ring">
          <svg viewBox="0 0 120 120" aria-hidden="true"><circle class="ring-bg" cx="60" cy="60" r="52" /><circle class="ring-fg" data-ring-fg cx="60" cy="60" r="52" transform="rotate(-90 60 60)" /></svg>
          <div class="big-ring-text"><b data-stat="percent">0</b><small>%</small></div>
        </div>
        <ul class="stat-list">
          <li><b><span data-stat="done">0</span><span class="of"> / {steps.length}</span></b><small>notes completed</small></li>
          <li><b data-stat="streak">0</b><small>day streak</small></li>
          <li><b data-stat="hours">0</b><small>hours learned</small></li>
          <li><b data-stat="remaining">–</b><small>reading left</small></li>
        </ul>
      </div>
    </section>

    <section class="rm-controls glass" data-reveal>
      <div class="chip-row" role="group" aria-label="Filter by status">
        <button class="chip on" data-filter-status="all">All</button>
        <button class="chip" data-filter-status="todo">To do</button>
        <button class="chip" data-filter-status="done">Done</button>
      </div>
      <div class="chip-row" role="group" aria-label="Filter by track">
        <button class="chip on" data-filter-track="all">All tracks</button>
        {(Object.keys(TRACKS) as TrackId[]).map((t) => <button class="chip" data-filter-track={t}>{TRACKS[t].icon} {TRACKS[t].name.split(' ')[0]}</button>)}
      </div>
      <input class="filter-input" data-filter-q type="search" placeholder="Filter notes…" aria-label="Filter notes by title" />
    </section>

    {stages.map((st) => (
      <section class="rm-stage" data-filter-section>
        <header class="rm-stage-head" data-reveal>
          <h2>{st.name}</h2>
          <span class="rm-stage-count" data-progress-group data-ids={st.steps.map((s) => s.note.id).join(',')}>
            <span data-progress-text>0/{st.steps.length}</span>
            <span class="bar"><i data-progress-bar></i></span>
          </span>
        </header>
        <ol class="rm-list">
          {st.steps.map((s) => (
            <li class="rm-row glass-hover" data-reveal data-filterable data-note-id={s.note.id} data-track={s.note.data.track}
                data-search={(s.note.data.title + ' ' + s.note.data.module + ' ' + s.note.data.summary).toLowerCase()}>
              <button class="check" data-toggle={s.note.id} aria-label={`Toggle ${s.note.data.title} complete`} title="Mark complete / not complete">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
              </button>
              <span class="step-no">{s.step}</span>
              <a class="rm-main" href={noteHref(s.note)}>
                <strong>{s.note.data.title}</strong>
                <span class="rm-sub">{TRACKS[s.note.data.track as TrackId].icon} {s.note.data.module} · {readingMinutes(s.note)} min</span>
              </a>
              <span class={`badge badge-${s.note.data.level}`}>{s.note.data.level}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
    <p class="rm-empty" data-filter-empty hidden>No notes match these filters.</p>

    <section class="rm-tools glass" data-reveal>
      <div>
        <h3>Your data stays on this device</h3>
        <p>Progress is stored in your browser only. Export it to move to another browser or keep a backup; import restores it.</p>
      </div>
      <div class="tool-buttons">
        <button class="btn" data-export>Export</button>
        <button class="btn" data-import>Import</button>
        <input type="file" accept="application/json" data-import-file hidden />
        <button class="btn danger" data-reset>Reset</button>
      </div>
    </section>
  </main>
</Base>
