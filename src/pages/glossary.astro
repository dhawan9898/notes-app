---
import Base from '../layouts/Base.astro';
import glossary from '../data/glossary.json';
import { lessonHref, loadAll, TRACKS } from '../lib/content';
const { lessons } = await loadAll();
const byTitle = new Map(lessons.map((l) => [l.data.title, l]));
const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const terms = [...glossary].sort((a, b) => a.term.localeCompare(b.term, 'en', { sensitivity: 'base' }));
const letters = [...new Set(terms.map((t) => t.term[0].toUpperCase()))];
const trackName = (t?: string) => Object.values(TRACKS).find((x) => x.short === t)?.short ?? t;
---
<Base title="Glossary · DeepNotes" description="Plain-language definitions of the terms used across the lessons." nav="learn">
  <div class="page narrow">
    <header class="page-head"><p class="eyebrow">Reference</p><h1>Glossary</h1><p class="lead">{terms.length} terms in plain language, each with the lesson that explains it properly.</p></header>
    <nav class="alpha" aria-label="Jump to letter">{letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}</nav>
    {letters.map((l) => (
      <section class="gl-section" id={`letter-${l}`} aria-label={l}>
        <h2 class="gl-letter">{l}</h2>
        <dl class="gl-list">
          {terms.filter((t) => t.term[0].toUpperCase() === l).map((t) => (
            <div class="gl-item" id={slug(t.term)}>
              <dt>{t.term}{t.track && <span class="tag">{trackName(t.track)}</span>}</dt>
              <dd>{t.def}{t.see && byTitle.has(t.see) && <> <a href={lessonHref(byTitle.get(t.see)!)}>Read: {t.see}</a></>}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
</Base>
