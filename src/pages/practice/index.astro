---
import Base from '../../layouts/Base.astro';
import Ring from '../../components/Ring.astro';
import PracticeNav from '../../components/PracticeNav.astro';
import ProblemRow from '../../components/ProblemRow.astro';
import { problems, loadAll, TRACKS, url } from '../../lib/content';
const { modules } = await loadAll();
const mods = modules.filter((m) => m.problems.length);
const tracks = [...new Set(problems.map((p) => p.track))];
const n = (d: string) => problems.filter((p) => p.difficulty === d).length;
---
<Base title="Practice problems · DeepNotes" description="Coding problems in C and questions with examples, hints, tests and saved submissions." nav="practice">
  <div class="page" data-pl>
    <header class="page-head">
      <p class="eyebrow">Practice</p>
      <h1>Problems</h1>
      <p class="lead">{problems.length} problems from the lessons. Code problems run their tests on your device; your code is saved when you submit.</p>
    </header>
    <PracticeNav current="problems" />

    <section class="summary card plain" data-meter="problems">
      <Ring size={72} />
      <div class="summary-text"><b><span data-n-done>0</span> / {problems.length}</b> solved</div>
      <dl class="diffs">
        <div class="d-easy"><dt>Easy</dt><dd><span data-stat="solved-easy">0</span> / {n('Easy')}</dd></div>
        <div class="d-medium"><dt>Medium</dt><dd><span data-stat="solved-medium">0</span> / {n('Medium')}</dd></div>
        <div class="d-hard"><dt>Hard</dt><dd><span data-stat="solved-hard">0</span> / {n('Hard')}</dd></div>
      </dl>
    </section>

    <div class="filters">
      <input class="input" type="search" placeholder="Search problems" aria-label="Search problems" data-pl-q />
      <div class="chips" role="group" aria-label="Track"><button class="chip on" type="button" data-pl-track="">All</button>{tracks.map((t) => <button class="chip" type="button" data-pl-track={t}>{TRACKS[t].short}</button>)}</div>
      <div class="chips" role="group" aria-label="Difficulty"><button class="chip on" type="button" data-pl-diff="">Any level</button>{['Easy', 'Medium', 'Hard'].map((d) => <button class="chip" type="button" data-pl-diff={d}>{d}</button>)}</div>
      <div class="chips" role="group" aria-label="Kind"><button class="chip on" type="button" data-pl-kind="">Code and questions</button><button class="chip" type="button" data-pl-kind="code">Code</button><button class="chip" type="button" data-pl-kind="question">Questions</button></div>
      <div class="chips" role="group" aria-label="Status"><button class="chip on" type="button" data-pl-status="">All</button><button class="chip" type="button" data-pl-status="todo">To do</button><button class="chip" type="button" data-pl-status="attempted">Attempted</button><button class="chip" type="button" data-pl-status="solved">Solved</button></div>
      <label class="select"><span class="sr-only">Module</span>
        <select data-pl-module><option value="">All modules</option>{mods.map((m) => <option value={m.title} data-track={m.track}>{TRACKS[m.track].short} · {m.title} ({m.problems.length})</option>)}</select>
      </label>
    </div>

    <ol class="list">{problems.map((p, i) => <ProblemRow problem={p} num={i + 1} />)}</ol>
    <p class="empty" data-pl-empty hidden>No problem matches these filters.</p>
    <p class="muted foot-note">Progress and code stay on this device. <a href={url('/you/')}>Back up or move them</a> from the You page.</p>
  </div>
</Base>
<script>import '../../scripts/practice-list';</script>
