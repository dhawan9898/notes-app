---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { problems, problemHref, lessonHref, loadAll, TRACKS, url, type Problem } from '../../../lib/content';
import '../../../styles/problem.css';

export function getStaticPaths() {
  return problems.map((p, i) => {
    const same = problems.filter((q) => q.track === p.track), k = same.indexOf(p);
    return { params: { track: p.track, slug: p.slug }, props: { p, n: i + 1, prev: same[k - 1], next: same[k + 1] } };
  });
}
const { p, n, prev, next } = Astro.props as { p: Problem & any; n: number; prev?: Problem; next?: Problem };
const { modules } = await loadAll();
const mod = modules.find((m) => m.track === p.track && m.title === p.module);
const isCode = p.kind === 'code';
const payload = {
  id: p.id, kind: p.kind, title: p.title, hints: p.hints ?? [], next: next ? problemHref(next) : '', nextTitle: next?.title ?? '', lesson: url(`/${p.track}/#${mod?.slug ?? ''}`),
  ...(isCode ? { prefix: p.code.prefix, starter: p.code.starter, suffix: p.code.suffix, solution: p.code.solution } : {}),
};
const given = isCode ? p.code.prefix.replace(/^\/\/ .*\n/gm, '').replace(/\/\* ===== Your code.*\*\/\n?$/, '').trim() : '';
const symbols = ['Tab', '{', '}', '(', ')', '[', ']', ';', '*', '&', '->', '=', '<', '>', '"', '%', '!', '|'];
const tint = TRACKS[p.track as keyof typeof TRACKS].tint;
---
<Base title={`${p.title} · Practice · DeepNotes`} description={`${p.title}: a ${p.difficulty.toLowerCase()} ${isCode ? 'C coding problem' : 'question'} in ${p.module}.`} nav="practice">
  <div class="pp" data-problem data-id={p.id} data-kind={p.kind} data-tint={tint}>
    <header class="pp-bar">
      <a class="pp-back" href={url('/practice/')} aria-label="All problems"><Icon name="back" size={18} /><span>Problems</span></a>
      <h1 class="pp-title"><span class="pp-n">{n}.</span> {p.title}</h1>
      <span class={`diff d-${p.difficulty.toLowerCase()}`}>{p.difficulty}</span>
      <span class="pp-solved" data-pp-solved hidden><Icon name="check" size={14} /> Solved</span>
      <span class="grow"></span>
      {prev ? <a class="icon-btn" href={problemHref(prev)} title={prev.title} aria-label="Previous problem"><Icon name="back" /></a> : <span class="icon-btn off"><Icon name="back" /></span>}
      {next ? <a class="icon-btn" href={problemHref(next)} title={next.title} aria-label="Next problem"><Icon name="next" /></a> : <span class="icon-btn off"><Icon name="next" /></span>}
    </header>

    <div class="seg pp-seg" role="tablist" aria-label="Sections">
      <button role="tab" class="on" type="button" data-seg="desc" aria-selected="true">Description</button>
      <button role="tab" type="button" data-seg="work" aria-selected="false">{isCode ? 'Code' : 'Your notes'}</button>
      {isCode && <button role="tab" type="button" data-seg="result" aria-selected="false">Result<i class="pp-dot" data-pp-dot hidden></i></button>}
    </div>

    <div class="pp-grid" data-active="desc">
      <section class="pp-pane" data-pane="desc">
        <div class="tabs" role="tablist" aria-label="Problem">
          <button role="tab" class="on" type="button" data-tab="desc" aria-selected="true">Description</button>
          {p.hints?.length > 0 && <button role="tab" type="button" data-tab="hints" aria-selected="false">Hints</button>}
          <button role="tab" type="button" data-tab="solution" aria-selected="false">{isCode ? 'Solution' : 'Answer'}</button>
          {isCode && <button role="tab" type="button" data-tab="subs" aria-selected="false">Submissions<span class="count" data-pp-subcount hidden></span></button>}
        </div>
        <div class="pp-scroll">
          <div data-tabpane="desc">
            <div class="chips-static"><span class="tag">{TRACKS[p.track as keyof typeof TRACKS].short}</span><a class="tag" href={url(`/${p.track}/#${mod?.slug ?? ''}`)}>{p.module}</a>{p.tags.map((t: string) => <span class="tag">{t}</span>)}</div>
            <div class="prose problem-prose" set:html={p.statement} />
            {isCode && <>
              <h2 class="pp-h">Examples</h2>
              {p.examples.map((e: any, i: number) => (
                <div class="example"><p class="example-h">Example {i + 1}</p><dl>
                  <dt>Input</dt><dd><pre>{e.input}</pre></dd><dt>Output</dt><dd><pre>{e.output}</pre></dd>
                  {p.whyHtml[i] && <><dt>Why</dt><dd class="why" set:html={p.whyHtml[i]} /></>}
                </dl></div>
              ))}
              <h2 class="pp-h">Constraints and edge cases</h2>
              <ul class="cons">{p.constraints.map((c: string) => <li set:html={c} />)}</ul>
              <h2 class="pp-h">How you are tested</h2>
              <p class="muted small">Your function runs against fixed test cases that include these examples and their edge cases. Edit only the function(s) in the editor: the given code and the tests are added around it. <b>Run</b> shows every test; <b>Submit</b> also saves your code and records the result.</p>
            </>}
            {!isCode && <p class="muted small">Think it through first, write down your reasoning, then open the answer and compare.</p>}
            <p class="muted small">Part of <a href={url(`/${p.track}/#${mod?.slug ?? ''}`)}>{p.module}</a>{mod?.lessons[0] && <> · <a href={lessonHref(mod.lessons[0])}>first lesson of the module</a></>}.</p>
          </div>
          {p.hints?.length > 0 && <div data-tabpane="hints" hidden>
            <p class="muted small">Try for a while first. Each hint gives away a little more.</p>
            <ol class="hints" data-pp-hints></ol>
            <button class="btn" type="button" data-pp-hint-btn>Show hint 1 of {p.hints.length}</button>
          </div>}
          <div data-tabpane="solution" hidden>
            <div data-pp-sol-gate>
              <p class="muted small">{isCode ? 'An explanation and a reference solution.' : 'The answer.'} Looking before you have tried takes away most of the learning.</p>
              <button class="btn" type="button" data-pp-sol-btn>{isCode ? 'Show the solution' : 'Show the answer'}</button>
            </div>
            <div data-pp-sol hidden>
              {p.explanation && <div class="prose problem-prose" set:html={p.explanation} />}
              {isCode && <><h2 class="pp-h">Reference solution</h2><pre class="codeview"><code data-pp-sol-code></code></pre></>}
            </div>
          </div>
          {isCode && <div data-tabpane="subs" hidden>
            <p class="empty-inline" data-pp-subs-empty>No submissions yet. Press Submit to save your code and record the result.</p>
            <ol class="subs" data-pp-subs></ol>
          </div>}
        </div>
      </section>

      {isCode ? (
        <section class="pp-right">
          <div class="pp-pane" data-pane="work">
            <div class="ed-bar">
              <span class="ed-lang">C <small>clang · WebAssembly</small></span>
              <span class="saved" data-pp-saved aria-live="polite"></span>
              <span class="grow"></span>
              <button class="mini" type="button" data-pp-last hidden>Last submission</button>
              <button class="mini" type="button" data-pp-reset>Reset</button>
            </div>
            <div class="ed" data-ed>
              <div class="ed-gutter" aria-hidden="true"><pre data-ed-gutter></pre></div>
              <div class="ed-main">
                <pre class="ed-hl" aria-hidden="true"><code data-ed-hl></code></pre>
                <textarea class="ed-ta" data-ed-ta spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off" wrap="off" aria-label="Your code (C)"></textarea>
              </div>
            </div>
            <div class="symbols" aria-label="Symbols">{symbols.map((s) => <button type="button" data-sym={s}>{s}</button>)}</div>
            <details class="given"><summary>Given code and tests (read-only)</summary><pre class="codeview"><code>{given}</code></pre><p class="muted small">The tests are appended after your code.</p></details>
          </div>
          <div class="pp-pane pp-result" data-pane="result" aria-live="polite">
            <div class="res-empty" data-pp-res-empty><Icon name="play" size={26} /><p><strong>Run your code</strong> to see the test results here.</p><p class="muted small"><kbd>Ctrl</kbd> + <kbd>Enter</kbd> runs, <kbd>Ctrl</kbd> + <kbd>Shift</kbd> + <kbd>Enter</kbd> submits.</p></div>
            <div data-pp-res hidden></div>
          </div>
        </section>
      ) : (
        <section class="pp-right">
          <div class="pp-pane" data-pane="work">
            <div class="ed-bar"><span class="ed-lang">Your notes</span><span class="saved" data-pp-saved aria-live="polite"></span></div>
            <textarea class="notes-ta" data-notes placeholder="Write your reasoning and your answer here. It is saved on this device." aria-label="Your notes"></textarea>
          </div>
        </section>
      )}
    </div>

    <div class="pp-actions">
      <span class="pp-status" data-pp-status aria-live="polite"></span>
      {isCode ? <>
        <button class="btn" type="button" data-pp-run><Icon name="play" size={16} /><span>Run</span></button>
        <button class="btn primary" type="button" data-pp-submit><span>Submit</span></button>
      </> : <>
        <button class="btn" type="button" data-q-review>Review again</button>
        <button class="btn primary" type="button" data-q-got><Icon name="check" size={16} /> I got it</button>
      </>}
    </div>

    <script is:inline type="application/json" id="pp-data" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
  </div>
</Base>
<script>import '../../../scripts/problem';</script>
