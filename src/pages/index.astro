---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Ring from '../components/Ring.astro';
import TrackCard from '../components/TrackCard.astro';
import PathCard from '../components/PathCard.astro';
import { TRACK_IDS, loadAll, loadPaths, problems, url } from '../lib/content';
const { lessons, labs } = await loadAll();
const paths = await loadPaths();
---
<Base title="DeepNotes · Learn systems engineering" nav="home">
  <div class="page">
    <section class="hero">
      <p class="eyebrow">Source-backed learning</p>
      <h1>Learn systems engineering, from your first program to the kernel.</h1>
      <p class="lead">{lessons.length} lessons, {problems.length} practice problems and {labs.length} labs on C, data structures and algorithms, Linux and networking. Each claim traces to a standard and each listing was run.</p>
      <a class="continue" data-continue="all" href={url('/learn/')}>
        <span class="continue-text"><span class="continue-label" data-continue-label>Start learning</span><strong class="continue-title" data-continue-title>Choose a track</strong></span>
        <Icon name="arrow" size={20} />
      </a>
      <dl class="mini-stats">
        <div><dt>Lessons done</dt><dd><b data-stat="done">0</b><small> / {lessons.length}</small></dd></div>
        <div><dt>Problems solved</dt><dd><b data-stat="solved">0</b><small> / {problems.length}</small></dd></div>
        <div><dt>Day streak</dt><dd><b data-stat="streak">0</b></dd></div>
      </dl>
    </section>

    <section class="block" aria-labelledby="h-tracks">
      <header class="block-head"><h2 id="h-tracks">Tracks</h2><a class="more" href={url('/learn/')}>All of Learn <Icon name="next" size={16} /></a></header>
      <div class="grid grid-4">{TRACK_IDS.map((t) => <TrackCard track={t} />)}</div>
    </section>

    <section class="block" aria-labelledby="h-paths">
      <header class="block-head"><h2 id="h-paths">Learning paths</h2><a class="more" href={url('/paths/')}>All paths <Icon name="next" size={16} /></a></header>
      <p class="block-sub">Pick a goal and follow the modules in order.</p>
      <div class="scroller">{paths.map((p) => <PathCard path={p} />)}</div>
    </section>

    <section class="block" aria-labelledby="h-practice">
      <header class="block-head"><h2 id="h-practice">Practice</h2><a class="more" href={url('/practice/')}>All practice <Icon name="next" size={16} /></a></header>
      <div class="grid grid-3">
        <a class="card" href={url('/practice/')} data-meter="problems">
          <span class="card-top"><span class="track-ic"><Icon name="practice" size={22} /></span><Ring /></span>
          <h3>Problems</h3><p class="muted">Code and questions with examples, hints and tests that run on your device. Your work is saved.</p>
          <span class="card-foot"><span><b data-n-done>0</b> of {problems.length} solved</span></span>
        </a>
        <a class="card" href={url('/practice/labs/')}>
          <span class="card-top"><span class="track-ic"><Icon name="flask" size={22} /></span></span>
          <h3>Labs</h3><p class="muted">Guided hands-on sessions with real commands and captured output.</p>
          <span class="card-foot"><span>{labs.length} labs</span></span>
        </a>
        <a class="card" href={url('/practice/playground/')}>
          <span class="card-top"><span class="track-ic"><Icon name="play" size={22} /></span></span>
          <h3>C playground</h3><p class="muted">Write any C program and run it. A real compiler runs in your browser, offline in the app.</p>
          <span class="card-foot"><span>No install</span></span>
        </a>
      </div>
    </section>
  </div>
</Base>
