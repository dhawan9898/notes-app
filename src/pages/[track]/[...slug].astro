---
import { render } from 'astro:content';
import ReadingPage from '../../components/ReadingPage.astro';
import { TRACKS, TRACK_IDS, loadAll, lessonHref, lessonSlug, minutesOf, url, type Lesson } from '../../lib/content';

export async function getStaticPaths() {
  const { lessons, modules } = await loadAll();
  return TRACK_IDS.flatMap((track) => {
    const inTrack = lessons.filter((l) => l.data.track === track);
    return inTrack.map((lesson, i) => ({
      params: { track, slug: lessonSlug(lesson) },
      props: { lesson, prev: inTrack[i - 1], next: inTrack[i + 1], module: modules.find((m) => m.track === track && m.title === lesson.data.module)! },
    }));
  });
}
const { lesson, prev, next, module: mod } = Astro.props;
const { Content, headings } = await render(lesson);
const { lessons } = await loadAll();
const d = lesson.data, byTitle = new Map(lessons.map((l) => [l.data.title, l]));
const link = (l: Lesson | undefined) => (l ? { title: l.data.title, href: lessonHref(l), hint: l.data.module !== d.module ? l.data.module : undefined } : undefined);
const leads = lessons.filter((n) => n.id !== lesson.id && n.data.prerequisites.includes(d.title))
  .map((n) => ({ title: n.data.title, href: lessonHref(n), track: n.data.track !== d.track ? TRACKS[n.data.track].short : undefined }));
const idx = mod.lessons.findIndex((l) => l.id === lesson.id);
---
<ReadingPage
  kind="lesson" id={lesson.id} title={d.title} summary={d.summary} level={d.level} minutes={minutesOf(lesson)} track={d.track}
  crumbs={[{ label: 'Learn', href: url('/learn/') }, { label: TRACKS[d.track].short, href: url(`/${d.track}/`) }, { label: d.module, href: url(`/${d.track}/#${mod.slug}`) }]}
  sideTitle={d.module} sideHref={url(`/${d.track}/#${mod.slug}`)}
  side={mod.lessons.map((l) => ({ title: l.data.title, href: lessonHref(l), current: l.id === lesson.id, key: l.id }))}
  toc={headings.filter((h) => h.depth === 2 || h.depth === 3)}
  prereqs={d.prerequisites.map((t) => ({ title: t, href: byTitle.has(t) ? lessonHref(byTitle.get(t)!) : undefined }))}
  prev={link(prev)} next={link(next)}
  practice={{ problems: mod.problems, labs: mod.labs, moduleTitle: mod.title }}
  leads={leads} sources={d.sources} position={`Lesson ${idx + 1} of ${mod.lessons.length}`}
><Content /></ReadingPage>
