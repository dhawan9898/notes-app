---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Ring from '../../components/Ring.astro';
import LessonRow from '../../components/LessonRow.astro';
import { TRACK_IDS, TRACKS, STAGES, modulesOf, fmtMinutes, levelRange, labHref, url, type TrackId } from '../../lib/content';

export function getStaticPaths() { return TRACK_IDS.map((track) => ({ params: { track } })); }
const track = Astro.params.track as TrackId;
const t = TRACKS[track];
const modules = await modulesOf(track);
const lessonCount = modules.reduce((a, m) => a + m.lessons.length, 0), minutes = modules.reduce((a, m) => a + m.minutes, 0);
const stages = STAGES.map((s) => ({ ...s, modules: modules.filter((m) => m.stage === s.id) })).filter((s) => s.modules.length);
---
<Base title={`${t.name} · DeepNotes`} description={t.blurb} nav="learn">
  <div class="page" data-tint={t.tint}>
    <nav class="crumbs" aria-label="Breadcrumb"><a href={url('/learn/')}>Learn</a><Icon name="next" size={14} /><span>{t.short}</span></nav>
    <header class="track-head" data-meter="lessons" data-prefix={`${track}/`}>
      <div>
        <p class="eyebrow">{t.standards}</p>
        <h1>{t.name}</h1>
        <p class="lead">{t.blurb}</p>
        <p class="facts">{lessonCount} lessons · {modules.length} modules · {fmtMinutes(minutes)} of reading</p>
        <a class="continue" data-continue={track} href={url(`/${track}/`)} hidden>
          <span class="continue-text"><span class="continue-label" data-continue-label>Start learning</span><strong class="continue-title" data-continue-title></strong></span>
          <Icon name="arrow" size={20} />
        </a>
      </div>
      <Ring size={84} />
    </header>

    <div class="toolbar">
      <nav class="jump" aria-label="Stages">{stages.map((s) => <a href={`#stage-${s.id}`}>{s.name}</a>)}</nav>
      <div class="chips" role="group" aria-label="Filter lessons"><button class="chip on" type="button" data-filter-status="all">All</button><button class="chip" type="button" data-filter-status="todo">To do</button><button class="chip" type="button" data-filter-status="done">Done</button></div>
    </div>

    {stages.map((s) => (
      <section class="stage" id={`stage-${s.id}`} aria-labelledby={`h-${s.id}`} data-filter-group>
        <header class="stage-head"><h2 id={`h-${s.id}`}>{s.name}</h2><p class="muted">{s.blurb}</p></header>
        {s.modules.map((m) => (
          <article class="module" id={m.slug} data-filter-group data-meter="lessons" data-prefix={m.prefix}>
            <header class="module-head">
              <span class="module-n">{m.number}</span>
              <div class="module-title"><h3>{m.title}</h3><p class="muted">{m.lessons.length} lessons · {fmtMinutes(m.minutes)} · {levelRange(m.levels)}</p></div>
              <span class="module-meter"><span class="bar"><i data-fill></i></span><span class="meter-text" data-text>0/{m.lessons.length}</span></span>
            </header>
            <div class="list">{m.lessons.map((l, i) => <LessonRow lesson={l} num={`${m.number}.${i + 1}`} />)}</div>
            {(m.problems.length > 0 || m.labs.length > 0) && (
              <footer class="module-practice">
                <span class="mp-label"><Icon name="practice" size={16} /> Practice</span>
                {m.problems.length > 0 && <a href={url(`/practice/?track=${track}&module=${encodeURIComponent(m.title)}`)}>{m.problems.length} {m.problems.length === 1 ? 'problem' : 'problems'}</a>}
                {m.labs.map((lab) => <a href={labHref(lab)}><Icon name="flask" size={14} /> {lab.data.title}</a>)}
              </footer>
            )}
          </article>
        ))}
      </section>
    ))}
    <p class="empty" data-filter-empty hidden>No lessons match this filter.</p>
  </div>
</Base>
